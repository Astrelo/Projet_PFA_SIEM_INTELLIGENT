# ===========================================
# Règles Snort Personnalisées — SIEM PFA
# ===========================================

# Détection scan de ports SYN
alert tcp any any -> $HOME_NET any \
  (msg:"SCAN SYN Port Scan Detected"; \
  flags:S; threshold:type threshold, track by_src, count 20, seconds 3; \
  classtype:attempted-recon; sid:1000001; rev:1;)

# Détection scan nmap agressif
alert tcp any any -> $HOME_NET any \
  (msg:"SCAN Nmap Aggressive Scan"; \
  flags:SF; threshold:type threshold, track by_src, count 10, seconds 2; \
  classtype:attempted-recon; sid:1000002; rev:1;)

# Détection brute force SSH
alert tcp any any -> $HOME_NET 22 \
  (msg:"BRUTE FORCE SSH Login Attempt"; \
  threshold:type threshold, track by_src, count 5, seconds 60; \
  classtype:attempted-admin; sid:1000003; rev:1;)

# Détection SYN Flood
alert tcp any any -> $HOME_NET any \
  (msg:"DOS SYN Flood Attack"; \
  flags:S!A; threshold:type threshold, track by_src, count 500, seconds 5; \
  classtype:attempted-dos; sid:1000004; rev:1;)

# Détection Ping Flood ICMP
alert icmp any any -> $HOME_NET any \
  (msg:"DOS ICMP Ping Flood"; \
  itype:8; threshold:type threshold, track by_src, count 100, seconds 2; \
  classtype:attempted-dos; sid:1000005; rev:1;)

# Détection scan UDP
alert udp any any -> $HOME_NET any \
  (msg:"SCAN UDP Port Scan"; \
  threshold:type threshold, track by_src, count 20, seconds 3; \
  classtype:attempted-recon; sid:1000006; rev:1;)
